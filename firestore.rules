rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validators ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.preferredLanguage is string && data.preferredLanguage.size() >= 1 && data.preferredLanguage.size() <= 20 &&
             data.themeMode in ['SYSTEM', 'DARK', 'LIGHT'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavedCreation(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.localId is string && isValidId(data.localId) &&
             data.type in ['IMAGE', 'WRITING', 'VIDEO_PLAN', 'PHOTO_QA', 'VOICE_SCRIPT', 'QR_CODE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.content is string && data.content.size() <= 30000 &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 4000)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 20)) &&
             data.favorite is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserNote(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.localId is string && isValidId(data.localId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.body is string && data.body.size() <= 30000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.pinned is bool &&
             data.favorite is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChatSessionSummary(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.localId is string && isValidId(data.localId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 20 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 500 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLanguage', 'themeMode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'preferredLanguage', 'themeMode', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'themeMode', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /creations/{creationId} {
        allow get: if isOwner(userId) && isValidId(creationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(creationId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'type', 'title', 'content', 'favorite', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'type', 'title', 'content', 'prompt', 'language', 'favorite', 'createdAt', 'updatedAt']) &&
                         isValidSavedCreation(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(creationId) &&
                         isValidSavedCreation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'prompt', 'language', 'favorite', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(creationId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(noteId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'title', 'body', 'category', 'pinned', 'favorite', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'title', 'body', 'category', 'pinned', 'favorite', 'createdAt', 'updatedAt']) &&
                         isValidUserNote(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(noteId) &&
                         isValidUserNote(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'pinned', 'favorite', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /chats/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(sessionId) &&
                         incoming().keys().hasAll(['userId', 'localId', 'title', 'language', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'localId', 'title', 'language', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         isValidChatSessionSummary(incoming(), userId);

        allow update: if isOwner(userId) && isValidId(sessionId) &&
                         isValidChatSessionSummary(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().localId == existing().localId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'language', 'lastMessagePreview', 'messageCount', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
